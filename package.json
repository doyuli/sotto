{
  "name": "sotto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:win": "mygo build -platform windows/amd64,windows/arm64",
    "build:win:x64": "mygo build -platform windows/amd64",
    "build:win:arm64": "mygo build -platform windows/arm64",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mygo-runtime": "^0.7.4"
  },
  "devDependencies": {
    "mygo-cli": "^0.7.4",
    "typescript": "^7",
    "vite": "^8"
  }
}
