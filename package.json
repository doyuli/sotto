{
  "name": "sotto",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:mac": "mygo build -platform darwin/arm64",
    "build:win": "export GOFLAGS=\"-tags=mygo_nowebview $GOFLAGS\" && mygo build -platform windows/amd64,windows/arm64",
    "build:win:x64": "export GOFLAGS=\"-tags=mygo_nowebview $GOFLAGS\" && mygo build -platform windows/amd64",
    "build:win:arm64": "export GOFLAGS=\"-tags=mygo_nowebview $GOFLAGS\" && mygo build -platform windows/arm64",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "mygo-cli": "0.9.2"
  }
}
